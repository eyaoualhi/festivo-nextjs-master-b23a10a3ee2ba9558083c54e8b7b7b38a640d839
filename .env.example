# Copier ce fichier en .env.local et renseigner les valeurs.

# Base de données — MongoDB + Mongoose (décision D-09, cours ch. 5)
# Local : mongodb://127.0.0.1:27017/festivo — Atlas : mongodb+srv://<user>:<mot-de-passe>@<cluster>/festivo
MONGODB_URI=mongodb+srv://eyaoualhi_db_user:eya123@cluster0.q9g2f01.mongodb.net/

AUTH_SECRET=DEODJjpdD2lVwM/ACvX0zqvd2JjfzVX+2VHVLu69tjU=
NEXTAUTH_SECRET=DEODJjpdD2lVwM/ACvX0zqvd2JjfzVX+2VHVLu69tjU=
# Autorise next-auth hors Vercel (`npm run start`, serveur de démonstration).
AUTH_TRUST_HOST=true

# Adresse publique de l'application, utilisée dans les liens des e-mails (décision D-31).
APP_URL=http://localhost:3000

# E-mails — Nodemailer en SMTP (décision D-31). Laisser SMTP_HOST vide pour afficher les
# e-mails dans le terminal du serveur au lieu de les envoyer.
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<adresse Gmail>,
# SMTP_PASS=<mot de passe d'application>, MAIL_FROM="Festivo <adresse Gmail>"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Jeu de démonstration — `npm run seed` (décision D-33) : mot de passe des comptes
# organisateurs de démonstration (8 caractères minimum).
SEED_ORGANIZER_PASSWORD=

# Tests de bout en bout — Playwright (décision D-24) : adresse du serveur lancé par `npm run dev`
# ou `npm run start`.
PLAYWRIGHT_BASE_URL=http://localhost:3000
